{
  "name": "storage-inventory",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test tests/domain.test.mjs tests/export.test.mjs",
    "test:browser": "playwright test",
    "test:rules": "firebase emulators:exec --project demo-storage-inventory --only firestore \"node --test tests/rules.test.mjs\"",
    "test:integration": "firebase emulators:exec --project demo-storage-inventory --only firestore \"playwright test --config playwright.integration.config.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "@playwright/test": "1.64.1",
    "exceljs": "4.4.0",
    "firebase": "13.1.0",
    "firebase-tools": "15.34.1"
  }
}
